# -----------------------------------------------------------------------
# Green Cloud Cost Optimization — environment variables
# Copy this file to .env and fill in all required values.
# Never commit your .env file to source control.
# -----------------------------------------------------------------------

# ---- Backend: authentication ----------------------------------------
# Secret used to sign and verify JWT tokens. Use a long random string.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Admin login credentials for the /login endpoint.
# Defaults: admin / admin123 — change before any shared deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Pre-computed pbkdf2_sha256 hash of ADMIN_PASSWORD (optional).
# If set, ADMIN_PASSWORD is ignored. Useful for not storing plaintext passwords.
# Generate: python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['pbkdf2_sha256']).hash('yourpassword'))"
ADMIN_PASSWORD_HASH=

# ---- Backend: CORS ---------------------------------------------------
# Comma-separated list of allowed origins for the CORS middleware.
# Leave empty to allow all origins (not recommended for production).
# Example: https://your-frontend.example.com,http://localhost:5173
ALLOWED_ORIGINS=

# ---- Backend: Electricity Maps carbon data --------------------------
# API key from https://www.electricitymaps.com/
ELECTRICITY_MAPS_API_KEY=

# ---- HashiCorp Vault (optional) -------------------------------------
# Set ENABLE_VAULT_BOOTSTRAP=true to load JWT_SECRET and
# ELECTRICITY_MAPS_API_KEY from Vault at startup.
ENABLE_VAULT_BOOTSTRAP=false
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_SECRET_PATH=green-cloud-guardian
VAULT_KV_MOUNT=secret

# ---- Grafana ---------------------------------------------------------
GRAFANA_ADMIN_USER=admin
# Change this to a strong password before any shared deployment.
GRAFANA_ADMIN_PASSWORD=
